<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of Écho's goes into backups or onto a new phone: its sources'
     sign-ins are encrypted with a key kept next to them, so copying both
     would copy the sign-ins too. After a phone change, verify the sources again. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
