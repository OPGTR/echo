<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/echo_background</item>
        <item name="colorPrimaryDark">@color/echo_background</item>
        <item name="colorAccent">@color/echo_accent</item>
        <item name="android:windowBackground">@color/echo_background</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/echo_background</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/echo_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

    <!-- The start screen follows the theme you chose (Android 13+ remembers it). -->
    <style name="AppTheme.NoActionBar.Luce">
        <item name="android:windowBackground">@color/echo_background_luce</item>
    </style>
    <style name="AppTheme.NoActionBar.Glass">
        <item name="android:windowBackground">@color/echo_background_glass</item>
    </style>
    <style name="SplashLuce" parent="AppTheme.NoActionBarLaunch">
        <item name="windowSplashScreenBackground">@color/echo_background_luce</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_rings_luce</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar.Luce</item>
    </style>
    <style name="SplashGlass" parent="AppTheme.NoActionBarLaunch">
        <item name="windowSplashScreenBackground">@color/echo_background_glass</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_rings_glass</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar.Glass</item>
    </style>
</resources>
